# Copy this file to ".env" and fill in your own keys.
# The .env file is listed in .gitignore, so it is never uploaded to GitHub.

# AI model API key (Week 2 onwards). Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: openFDA key for higher download limits. Get one at https://open.fda.gov/apis/authentication/
OPENFDA_API_KEY=
