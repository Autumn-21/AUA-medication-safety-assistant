# Copy this file to ".env" and fill in your settings.
# The .env file is listed in .gitignore, so it is never uploaded to GitHub.

# --- AI model (free) ---------------------------------------------------------------
# Option A (recommended): Google Gemini free tier. No credit card needed.
#   Get a free key at https://aistudio.google.com/apikey and paste it below.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
#   If the model name is not accepted, list the ones your key can use:  python -m src.llm

# Option B: a free model on your own laptop with Ollama (no account, nothing leaves your computer).
#   1. Install Ollama from https://ollama.com   2. Run:  ollama pull qwen2.5:7b
#   3. Change the line above to LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5:7b

# --- Search settings ---------------------------------------------------------------
# "sentence-transformers" (best, downloads a model once) or "tfidf" (offline fallback)
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
TOP_K=5

# Optional: openFDA key for higher download limits. https://open.fda.gov/apis/authentication/
OPENFDA_API_KEY=
